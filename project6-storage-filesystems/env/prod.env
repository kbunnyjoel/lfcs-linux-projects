

# Production environment configuration for project6-storage-filesystems

# Filesystem watchdog thresholds (stricter in prod)
FS_MIN_FREE_PCT=10
FS_MIN_INODES_PCT=5

# Expected fstab options (example)
FS_FSTAB=/etc/fstab
FS_EXPECT_OPTS="/tmp:nodev,nosuid,noexec"

# Run in real mode by default in prod
FS_MODE=real
FS_PATHS="/var /tmp"
FS_ARGS="--path /var --path /tmp --json"
