# Production environment for project7-security-auditing (stricter defaults)

SEC_FIREWALL_REQUIRED=1
# Accept at least permissive; set to enforcing to be strict
SEC_SELINUX_MODE=enforcing
SEC_APPARMOR_REQUIRED=1
# Provide a rules file inside container/host path if desired
SEC_AUDIT_RULES_FILE=/etc/audit/rules.d/hardening.rules
# Alert if too many failed logins in last day
SEC_AUTH_MAX_FAILED=5
SEC_AIDE_REQUIRED=

# Optional: default arguments used by systemd/cron wrappers
# Example: require firewall, enforcing SELinux, AppArmor, audit rules file and auth threshold
SEC_ARGS="--json --firewall required --selinux enforcing --apparmor required --audit rules /etc/audit/rules.d/hardening.rules --auth max-failed 5"
