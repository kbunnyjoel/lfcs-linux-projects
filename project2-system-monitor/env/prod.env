ENV=prod
OUTPUT_DIR="outputs"
FORMAT="json,prom"

CPU_WARN=75
MEM_WARN=80
DISK_WARN=80

CHECK_PROCESSES="nginx,sshd"
INTERVAL=0    # watch mode interval in seconds (0 = disabled, run once)


# --- Advanced options (safe defaults; do not change current behavior) ---

# Enable/disable collecting top-N processes (enabled = active)
TOP_PROCS_ENABLE=true
TOP_PROCS=5            # show top 5 when enabled
TOP_PROCS_IGNORE=""   # comma-separated names to ignore (case-insensitive), e.g., "chrome,windowserver"

# Optional: per-mount disk usage (comma-separated). Example for macOS:
DISK_MOUNTS="/,/var,/home"
# Leave unset to default to root filesystem only.

# Expose Prometheus metrics via a tiny HTTP server (future feature)
PROM_HTTP_ENABLE=false
PROM_HTTP_PORT=9100

# Logging verbosity for future use: debug|info|warn
LOG_LEVEL=info
