# Prod environment for service watchdog

# Services to watch (space-separated)
WATCH_SERVICES="nginx mysql redis"

# Check interval (seconds)
WATCH_INTERVAL=60

# Retry/backoff knobs
WATCH_RETRY_INTERVAL=1
WATCH_BACKOFF_MODE="exp"        # none|linear|exp
WATCH_RETRY_MAX_INTERVAL=30
WATCH_BACKOFF_JITTER=0.2

# Restart policy (true/false)
WATCH_RESTART=true

# Notification method (stdout/email)
WATCH_NOTIFY="email"

# Max retries for restart attempts
WATCH_MAX_RETRIES=5

# Health and start command paths
WATCH_HEALTH_CMD="/usr/local/bin/health.sh"
WATCH_START_CMD="/usr/local/bin/restart.sh"

WATCH_EMAIL="bunnyjoel391@gmail.com"
WATCH_FROM_EMAIL="watchdog-prod@local"


WATCH_LOG_FILE="/app/logs/prod_watch.log"

# Notify aliases for compatibility
EMAIL_TO="$WATCH_EMAIL"
EMAIL_FROM="$WATCH_FROM_EMAIL"
