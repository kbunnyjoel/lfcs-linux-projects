# Dev environment for service watchdog

# Services to watch (space-separated)
WATCH_SERVICES="nginx mysql redis"

# Check interval in seconds (periodic loop); tests run one-off checks and do not use this in Sprint 2
# For retry-specific timing, see WATCH_RETRY_INTERVAL below
WATCH_INTERVAL=60

# Restart policy: true/false
WATCH_RESTART=true

# Notification method (stdout/email)
WATCH_NOTIFY="email"

# Maximum retries for restart attempts
WATCH_MAX_RETRIES=5

# Retry/backoff settings for restart attempts
# Base wait between retries (seconds)
WATCH_RETRY_INTERVAL=1
# Backoff strategy for retries: none|linear|exp
WATCH_BACKOFF_MODE="exp"
# Maximum wait between retries (seconds)
WATCH_RETRY_MAX_INTERVAL=30
# Jitter factor (0.0–1.0) applied to waits
WATCH_BACKOFF_JITTER=0.2

# Optional health and start command paths
WATCH_HEALTH_CMD="/usr/local/bin/health.sh"
WATCH_START_CMD="/usr/local/bin/restart.sh"

WATCH_EMAIL="dev-bunnyjoel391@gmail.com"
WATCH_FROM_EMAIL="watchdog-dev@local"

# Aliases for notify.sh (it also accepts EMAIL_TO/EMAIL_FROM)
EMAIL_TO="$WATCH_EMAIL"
EMAIL_FROM="$WATCH_FROM_EMAIL"

WATCH_LOG_FILE="/app/logs/dev_watch.log"
